# ─────────────────────────────────────────────────────────────
#  إعدادات Apache — لاستضافات cPanel / Hostinger / GoDaddy وغيرها
#  ضع هذا الملف مع index.html في مجلد public_html
# ─────────────────────────────────────────────────────────────

# ترميز UTF-8 حتى تظهر العربية سليمة
AddDefaultCharset UTF-8

# أنواع الملفات الحديثة (بعض الخوادم القديمة لا تعرفها)
<IfModule mod_mime.c>
  AddType image/webp                 .webp
  AddType font/woff2                 .woff2
  AddType image/svg+xml              .svg
</IfModule>

# ضغط الملفات النصية لتسريع التحميل
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# تخزين مؤقت طويل للأصول (أسماؤها تحمل بصمة فلا تتعارض)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp           "access plus 1 year"
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType font/woff2           "access plus 1 year"
  ExpiresByType text/css             "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# تطبيق أحادي الصفحة: أي مسار غير موجود يعود إلى index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>
